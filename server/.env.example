# Cổng chạy ứng dụng Backend
PORT=5000
NODE_ENV=development

# Kết nối Cơ sở dữ liệu PostgreSQL (Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/trendyfit_db?schema=public"

# Bảo mật JWT Authentication
JWT_ACCESS_SECRET="trendyfit_jwt_access_secret_key_change_in_production_2026"
JWT_REFRESH_SECRET="trendyfit_jwt_refresh_secret_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PayOS Cổng thanh toán VietQR
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"

# Chế độ Giả lập Thanh toán (Mock Payment Engine)
# CHỈ BẬT khi DEV hoặc DEMO vấn đáp! Bắt buộc =false khi Production
PAYMENT_MOCK_MODE=true

# Cấu hình CORS Frontend
CLIENT_URL="http://localhost:3000"
